# Значения вставляются в настройки Vercel (Settings → Environment Variables),
# а не в этот файл. Здесь только список того, что нужно задать.
# Файл .env с реальными значениями в репозиторий не коммитить.

# Токен бота из BotFather — им сервер проверяет подпись Telegram
# и отправляет приветствие на /start
TELEGRAM_BOT_TOKEN=

# Адрес мини-приложения (для кнопки «Открыть» в приветствии бота)
APP_URL=https://sitkaz.kz

# Секрет вебхука бота — любая случайная строка. Тот же секрет передаётся
# в setWebhook (?secret_token=...), сервер сверяет заголовок от Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
